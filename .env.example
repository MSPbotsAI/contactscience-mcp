# Optional overrides — contactscience-mcp has no required env vars.
# Authentication is per-request via the X-ContactScience-Authorization header
# (a static Contact Science API token, generated in the Contact Science
# admin portal). This server forwards it verbatim (no "Bearer " prefix) as
# the upstream "authorization" header on every call, matching MSPbots' own
# configured header template ("value": "#{authorization}").

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Fixed Contact Science API base URL — override only if Contact Science
# provisions a different host for your organization.
# CONTACTSCIENCE_BASE_URL=https://www.klpzmedia.com/apis/1.0
